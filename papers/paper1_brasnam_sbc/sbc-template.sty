% sbc-template.sty
% Pacote de estilo oficial para artigos da Sociedade Brasileira de Computação (SBC)
% Atualizado para compatibilidade com pdflatex, Overleaf e TeX Live.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{sbc-template}[2005/06/17 SBC style package]

\RequirePackage[a4paper,top=3.5cm,bottom=2.5cm,left=3.0cm,right=3.0cm]{geometry}
\RequirePackage{times}

\parindent 1.27cm
\parskip   0pt

% Formatação dos Títulos de Seção
\def\section{\@startsection{section}{1}{\z@}{-12pt plus -2pt minus -2pt}{6pt plus 2pt minus 2pt}{\reset@font\bfseries\normalsize}}
\def\subsection{\@startsection{subsection}{2}{\z@}{-10pt plus -2pt minus -2pt}{4pt plus 2pt minus 2pt}{\reset@font\bfseries\normalsize}}
\def\subsubsection{\@startsection{subsubsection}{3}{\z@}{-8pt plus -2pt minus -2pt}{3pt plus 1pt minus 1pt}{\reset@font\itshape\normalsize}}

% Ambientes de Abstract e Resumo
\newenvironment{resumo}{%
  \begin{center}%
    {\bfseries Resumo\vspace{-.5em}\vspace{\z@}}%
  \end{center}%
  \small\itshape\noindent\ignorespaces
}{%
  \par\vspace{1em}
}

\renewenvironment{abstract}{%
  \begin{center}%
    {\bfseries Abstract\vspace{-.5em}\vspace{\z@}}%
  \end{center}%
  \small\itshape\noindent\ignorespaces
}{%
  \par\vspace{1em}
}

% Formatação de Legenda de Figuras e Tabelas
\RequirePackage{caption}
\captionsetup{font=small,labelfont=bf,labelsep=period}

\endinput
